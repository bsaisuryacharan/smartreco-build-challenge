# Mesh API (required — https://meshapi.ai)
MESH_API_KEY=rsk_your_key_here

# JWT
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# LangSmith observability (optional bonus)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=smartreco

# Email digest (optional — leave blank to log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=noreply@smartreco.ai
DIGEST_HOUR=9

# App
APP_ENV=development
DATABASE_URL=sqlite:///./smartreco.db
CHROMA_PERSIST_DIR=./chroma_db
